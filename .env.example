# Copy to .env. Keep the JSON on one line; never commit .env.
# The same JSON can be stored in GitHub Actions secret PATROL_AUTH (without quotes).
PATROL_AUTH='{"picacg":{"credentials":{"username":"YOUR_USERNAME","password":"YOUR_PASSWORD"}},"ehentai":{"credentials":{"cookieValues":{"ipb_member_id":"YOUR_MEMBER_ID","ipb_pass_hash":"YOUR_PASS_HASH","igneous":"YOUR_IGNEOUS","star":""}}}}'

# Optional exported session state; normally generated automatically in
# .patrol-state/PATROL_AUTH_STATE.json. Same JSON format as the Actions Secret.
# PATROL_AUTH_STATE='{"version":1,"sources":{}}'
