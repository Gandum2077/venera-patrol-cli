{
  "version": 1,
  "configPaths": ["../Github/venera-configs"],
  "output": "reports",
  "defaults": {
    "concurrency": 2,
    "stageTimeoutMs": 30000,
    "sourceTimeoutMs": 300000,
    "requestTimeoutMs": 15000,
    "minRequestIntervalMs": 250,
    "retries": 1,
    "pages": 2,
    "imageSamples": 2,
    "maxRequests": 200,
    "maxResponseBytes": 20971520,
    "maxTraceEvents": 2000
  },
  "sources": {
    "copy_manga": {
      "inputs": {
        "keyword": "火影",
        "category": "热血",
        "categoryParam": "rexue"
      },
      "settings": {},
      "brokenCapabilities": {}
    },
    "picacg": {
      "inputs": {
        "keyword": "漫画"
      },
      "auth": "picacg"
    },
    "ehentai": {
      "inputs": {
        "keyword": "language:chinese"
      },
      "auth": "ehentai"
    }
  }
}
