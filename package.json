{
  "name": "venera-patrol-cli",
  "version": "1.0.0",
  "description": "Isolated, observable capability patrol for Venera sources",
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "venera-patrol": "bin/venera-patrol.js"
  },
  "exports": "./src/index.js",
  "files": [
    "bin",
    "src",
    "patrol.example.json",
    "README.md",
    "site",
    "scripts"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "patrol": "node bin/venera-patrol.js",
    "pages:build": "node scripts/pages.js build",
    "pages:preview": "node scripts/serve-site.js",
    "report:archive": "node scripts/pages.js archive",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "venera-runtime": "file:../venera-runtime"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "yaml": "^2.9.0"
  }
}
